NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Custom production domain (optional). Otherwise Vercel's production URL is used.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# AdSense: home, guide/example and eligible completed-library banners, production only.
# Publisher and public banner slot are already configured; overrides are optional.
# Set false and redeploy to disable banners while keeping ownership verification.
# NEXT_PUBLIC_ADSENSE_PUBLIC_BANNER_ENABLED=false
# NEXT_PUBLIC_ADSENSE_PUBLIC_BANNER_SLOT=9331445471
# Legacy ENABLED / COMPLETED_SLOT / LIBRARY_SLOT settings do not serve ads.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-YOUR_16_DIGIT_PUBLISHER_ID
