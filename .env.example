NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Custom production domain (optional). Otherwise Vercel's production URL is used.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# AdSense ownership verification only. Advertising is paused during review.
# Legacy ENABLED / COMPLETED_SLOT / LIBRARY_SLOT settings no longer serve ads.
# Optional override. The site's public publisher ID is already included for verification.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-YOUR_16_DIGIT_PUBLISHER_ID
