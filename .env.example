NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Custom production domain (optional). Otherwise Vercel's production URL is used.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional manual AdSense banners. Unconfigured/disabled banners render nothing.
# Create horizontal display ad units and keep AdSense Auto ads OFF.
# NEXT_PUBLIC_ADSENSE_ENABLED=true
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-YOUR_16_DIGIT_PUBLISHER_ID
# NEXT_PUBLIC_ADSENSE_COMPLETED_SLOT=YOUR_10_DIGIT_SLOT_ID
# NEXT_PUBLIC_ADSENSE_LIBRARY_SLOT=YOUR_10_DIGIT_SLOT_ID
# Test mode defaults to true. Set false only when approved and ready to serve ads.
# NEXT_PUBLIC_ADSENSE_TEST_MODE=true
